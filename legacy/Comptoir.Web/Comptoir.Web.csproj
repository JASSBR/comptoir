<Project Sdk="MSBuild.SDK.SystemWeb">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Comptoir.Web</RootNamespace>
    <!-- Off Windows (the developers' Macs), the Visual Studio web targets come from a package; CI builds on Windows. -->
    <WebApplicationsTargetPath Condition="'$(OS)' != 'Windows_NT'">$(NuGetPackageRoot)msbuild.microsoft.visualstudio.web.targets/14.0.0.3/tools/VSToolsPath/WebApplications/Microsoft.WebApplication.targets</WebApplicationsTargetPath>
    <!-- Precompiling Razor views (aspnet_compiler) needs Windows: CI does it there, so a broken view fails the build. -->
    <MvcBuildViews Condition="'$(OS)' != 'Windows_NT'">false</MvcBuildViews>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebPages" Version="3.3.0" />
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="MSBuild.Microsoft.VisualStudio.Web.targets" Version="14.0.0.3" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
